{
  "rewrites": [
    { "source": "/api/cron-reminders", "destination": "/api/index.ts" },
    { "source": "/api/whatsapp/webhook", "destination": "/api/index.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/whatsapp/webhook", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "* * * * *"
    }
  ]
}